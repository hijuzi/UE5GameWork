      </mxGeometry>
    </mxCell>

    <!-- Layout P0 → Layer: Modal -->
    <mxCell id="e-p0-modal" value=""
      style="edgeStyle=orthogonalEdgeStyle;endArrow=open;endFill=0;fontSize=10;exitX=0.55;exitY=1;exitDx=0;exitDy=0;"
      edge="1" parent="1" source="layout-p0" target="layer-modal">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="743" y="390"/>
          <mxPoint x="830" y="390"/>
          <mxPoint x="830" y="477"/>
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- Layer: Game → Widget -->
    <mxCell id="e-game-widget" value="PushWidgetToLayerStack"
      style="edgeStyle=orthogonalEdgeStyle;endArrow=open;endFill=0;fontSize=10;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;"
      edge="1" parent="1" source="layer-game" target="widget">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="620" y="590"/>
          <mxPoint x="580" y="590"/>
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- Extensions → UIManager (API call chain) -->
    <mxCell id="e-ext-mgr" value="API 调用"
      style="edgeStyle=orthogonalEdgeStyle;endArrow=open;endFill=0;fontSize=10;dashed=1;strokeColor=#0066CC;exitX=1;exitY=0.5;exitDx=0;exitDy=0;"
      edge="1" parent="1" source="ext" target="mgr">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="400" y="377"/>
          <mxPoint x="400" y="102"/>
        </Array>
      </mxGeometry>
    </mxCell>

  </root>
</mxGraphModel>
