<mxGraphModel page="1" pageWidth="1600" pageHeight="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" math="0" shadow="0">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <!-- ========== ZONE 1: Configuration (左上) ========== -->

    <mxCell id="cfg-engine" value="&lt;b&gt;DefaultEngine.ini&lt;/b&gt;&lt;br&gt;GameInstanceClass&lt;br&gt;LocalPlayerClassName"
      style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;"
      vertex="1" parent="1">
      <mxGeometry x="50" y="60" width="230" height="65" as="geometry"/>
    </mxCell>

    <mxCell id="cfg-game" value="&lt;b&gt;DefaultGame.ini&lt;/b&gt;&lt;br&gt;DefaultUIPolicyClass"
      style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;"
      vertex="1" parent="1">
      <mxGeometry x="50" y="150" width="230" height="55" as="geometry"/>
    </mxCell>

    <!-- ========== ZONE 2: Core Pipeline (顶部中央) ========== -->

    <!-- GameInstance -->
    <mxCell id="gi" value="&lt;b&gt;BLyraGameInstance&lt;/b&gt;&lt;br&gt;(LyraGameInstance)"
      style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;"
      vertex="1" parent="1">
      <mxGeometry x="420" y="70" width="210" height="65" as="geometry"/>
    </mxCell>

    <!-- UIManagerSubsystem -->
    <mxCell id="mgr" value="&lt;b&gt;ULyraUIManagerSubsystem&lt;/b&gt;&lt;br&gt;(GameInstanceSubsystem)"
      style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;"
      vertex="1" parent="1">
      <mxGeometry x="780" y="70" width="250" height="65" as="geometry"/>
    </mxCell>

    <!-- UIPolicy -->
    <mxCell id="policy" value="&lt;b&gt;BLyraUIPolicy&lt;/b&gt;&lt;br&gt;(GameUIPolicy)"
      style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;"
      vertex="1" parent="1">
      <mxGeometry x="1180" y="70" width="210" height="65" as="geometry"/>
    </mxCell>

    <!-- ========== ZONE 3: Per-Player Layouts (中部) ========== -->

    <!-- Layout Player 0 -->
    <mxCell id="layout-p0" value="&lt;b&gt;BLyraPrimaryGameLayout&lt;/b&gt;&lt;br&gt;(PrimaryGameLayout — Player 0)"
      style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad7ac;strokeColor=#b46504;fontSize=12;"
      vertex="1" parent="1">
      <mxGeometry x="600" y="250" width="260" height="65" as="geometry"/>
    </mxCell>

    <!-- Layout Player 1 -->
    <mxCell id="layout-p1" value="&lt;b&gt;BLyraPrimaryGameLayout&lt;/b&gt;&lt;br&gt;(PrimaryGameLayout — Player 1)"
      style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad7ac;strokeColor=#b46504;fontSize=12;"
      vertex="1" parent="1">
      <mxGeometry x="1060" y="250" width="260" height="65" as="geometry"/>
    </mxCell>

    <!-- ========== ZONE 4: Layer Stacks (中下部, 仅展示 Player 0) ========== -->

    <!-- Layer Group Label -->
    <mxCell id="layer-label" value="&lt;i&gt;Player 0 的 Layer 栈&lt;/i&gt;"
      style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=11;fontColor=#666666;"
      vertex="1" parent="1">
      <mxGeometry x="570" y="390" width="200" height="20" as="geometry"/>
    </mxCell>

    <!-- Layer: Game -->
    <mxCell id="layer-game" value="&lt;b&gt;UI.Layer.Game&lt;/b&gt;&lt;br&gt;CommonActivatableWidgetStack"
      style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;"
      vertex="1" parent="1">
      <mxGeometry x="530" y="420" width="180" height="55" as="geometry"/>
    </mxCell>

    <!-- Layer: GameMenu -->
    <mxCell id="layer-gamemenu" value="&lt;b&gt;UI.Layer.GameMenu&lt;/b&gt;&lt;br&gt;CommonActivatableWidgetStack"
      style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;"
      vertex="1" parent="1">
      <mxGeometry x="740" y="420" width="180" height="55" as="geometry"/>
    </mxCell>

    <!-- Layer: Menu -->
    <mxCell id="layer-menu" value="&lt;b&gt;UI.Layer.Menu&lt;/b&gt;&lt;br&gt;CommonActivatableWidgetStack"
      style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;"
      vertex="1" parent="1">
      <mxGeometry x="530" y="505" width="180" height="55" as="geometry"/>
    </mxCell>

    <!-- Layer: Modal -->
    <mxCell id="layer-modal" value="&lt;b&gt;UI.Layer.Modal&lt;/b&gt;&lt;br&gt;CommonActivatableWidgetStack"
      style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;"
      vertex="1" parent="1">
      <mxGeometry x="740" y="505" width="180" height="55" as="geometry"/>
    </mxCell>

    <!-- Layer count badge on Player 1 -->
    <mxCell id="p1-note" value="... 同样 4 层 Layer"
      style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=11;fontColor=#999999;fontStyle=2;"
      vertex="1" parent="1">
      <mxGeometry x="1100" y="380" width="180" height="20" as="geometry"/>
    </mxCell>

    <!-- ========== ZONE 5: Content Widget (底部) ========== -->

    <mxCell id="widget" value="&lt;b&gt;ULyraActivatableWidget&lt;/b&gt;&lt;br&gt;(具体 UI 面板：HUD、菜单、弹窗等)"
      style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;dashed=1;"
      vertex="1" parent="1">
      <mxGeometry x="580" y="620" width="290" height="55" as="geometry"/>
    </mxCell>

    <!-- ========== ZONE 6: Extensions (左侧工具栏) ========== -->

    <mxCell id="ext" value="&lt;b&gt;UCommonUIExtensions&lt;/b&gt;&lt;br&gt;(BlueprintFunctionLibrary)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;PushContentToLayer / PopContent / SuspendInput&lt;/font&gt;"
      style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;dashed=1;dashPattern=8 4;"
      vertex="1" parent="1">
      <mxGeometry x="50" y="340" width="280" height="75" as="geometry"/>
    </mxCell>

    <!-- ========== Legend (右上) ========== -->

    <mxCell id="legend-box" value=""
      style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;dashed=1;"
      vertex="1" parent="1">
      <mxGeometry x="1420" y="60" width="160" height="190" as="geometry"/>
    </mxCell>
    <mxCell id="legend-t1" value="—◇  归属 / Subsystem"
      style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=10;align=left;"
      vertex="1" parent="1">
      <mxGeometry x="1430" y="70" width="140" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="legend-t2" value="——  引用 / 持有"
      style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=10;align=left;"
      vertex="1" parent="1">
      <mxGeometry x="1430" y="95" width="140" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="legend-t3" value="- - -  API 调用"
      style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=10;align=left;fontColor=#0066CC;"
      vertex="1" parent="1">
      <mxGeometry x="1430" y="120" width="140" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="legend-t4" value="- - -  配置注入"
      style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=10;align=left;fontColor=#CC0000;"
      vertex="1" parent="1">
      <mxGeometry x="1430" y="145" width="140" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="legend-t5" value="▢ 虚线框 = Blueprint"
      style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=10;align=left;fontColor=#999999;"
      vertex="1" parent="1">
      <mxGeometry x="1430" y="175" width="140" height="20" as="geometry"/>
    </mxCell>

    <!-- ========== EDGES ========== -->

    <!-- Config → GameInstance -->
    <mxCell id="e-cfg-gi" value="GameInstanceClass"
      style="edgeStyle=orthogonalEdgeStyle;endArrow=open;endFill=0;fontSize=10;dashed=1;strokeColor=#CC0000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;"
      edge="1" parent="1" source="cfg-engine" target="gi">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="340" y="92"/>
          <mxPoint x="340" y="102"/>
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- Config → UIPolicy -->
    <mxCell id="e-cfg-policy" value="DefaultUIPolicyClass"
      style="edgeStyle=orthogonalEdgeStyle;endArrow=open;endFill=0;fontSize=10;dashed=1;strokeColor=#CC0000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;"
      edge="1" parent="1" source="cfg-game" target="policy">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="340" y="177"/>
          <mxPoint x="340" y="102"/>
          <mxPoint x="1285" y="102"/>
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- GameInstance → UIManager (Subsystem ownership) -->
    <mxCell id="e-gi-mgr" value="Subsystem"
      style="edgeStyle=orthogonalEdgeStyle;endArrow=open;endFill=0;startArrow=diamondThin;startFill=1;fontSize=11;"
      edge="1" parent="1" source="gi" target="mgr">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- UIManager → UIPolicy -->
    <mxCell id="e-mgr-policy" value="CurrentPolicy"
      style="edgeStyle=orthogonalEdgeStyle;endArrow=open;endFill=0;fontSize=11;"
      edge="1" parent="1" source="mgr" target="policy">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- UIPolicy → Layout P0 -->
    <mxCell id="e-policy-p0" value="CreateLayoutWidget"
      style="edgeStyle=orthogonalEdgeStyle;endArrow=open;endFill=0;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;"
      edge="1" parent="1" source="policy" target="layout-p0">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="1285" y="220"/>
          <mxPoint x="730" y="220"/>
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- UIPolicy → Layout P1 -->
    <mxCell id="e-policy-p1" value="RootViewportLayouts[]"
      style="edgeStyle=orthogonalEdgeStyle;endArrow=open;endFill=0;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;"
      edge="1" parent="1" source="policy" target="layout-p1">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="1285" y="220"/>
          <mxPoint x="1190" y="220"/>
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- Layout P0 → Layer: Game -->
    <mxCell id="e-p0-game" value="Layers"
      style="edgeStyle=orthogonalEdgeStyle;endArrow=open;endFill=0;startArrow=diamondThin;startFill=1;fontSize=10;exitX=0.3;exitY=1;exitDx=0;exitDy=0;"
      edge="1" parent="1" source="layout-p0" target="layer-game">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="678" y="390"/>
          <mxPoint x="620" y="390"/>
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- Layout P0 → Layer: GameMenu -->
    <mxCell id="e-p0-gamemenu" value=""
      style="edgeStyle=orthogonalEdgeStyle;endArrow=open;endFill=0;fontSize=10;exitX=0.55;exitY=1;exitDx=0;exitDy=0;"
      edge="1" parent="1" source="layout-p0" target="layer-gamemenu">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="743" y="390"/>
          <mxPoint x="830" y="390"/>
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- Layout P0 → Layer: Menu -->
    <mxCell id="e-p0-menu" value=""
      style="edgeStyle=orthogonalEdgeStyle;endArrow=open;endFill=0;fontSize=10;exitX=0.3;exitY=1;exitDx=0;exitDy=0;"
      edge="1" parent="1" source="layout-p0" target="layer-menu">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="678" y="390"/>
          <mxPoint x="620" y="390"/>
          <mxPoint x="620" y="477"/>
