<!-- FPredictionKey 结构 -->
<mxCell id="s1" value="&lt;b style=&quot;font-size:16px;&quot;&gt;FPredictionKey&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#555;&quot;&gt;对账令牌 · USTRUCT&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#999;&quot;&gt;─────────────────────────────&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;▸ +Current: int16 (唯一 ID)&lt;br&gt;▸ +Base: int16 (NotReplicated, 依赖链根)&lt;br&gt;▸ +bIsServerInitiated: bool&lt;br&gt;▸ -PredictiveConnectionObjectKey: FObjectKey&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;arcSize=14;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
  <mxGeometry x="60" y="70" width="340" height="190" as="geometry"/>
</mxCell>

<!-- 委托机制 -->
<mxCell id="s2" value="&lt;b style=&quot;font-size:16px;&quot;&gt;回滚钩子&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#555;&quot;&gt;Undo / Redo 入口&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#999;&quot;&gt;─────────────────────────────&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;▸ NewRejectedDelegate() — 明确拒绝&lt;br&gt;▸ NewCaughtUpDelegate() — 状态追上&lt;br&gt;▸ NewRejectOrCaughtUpDelegate() — 任一&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;▸ 转发到 FPredictionKeyDelegates&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;arcSize=14;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
  <mxGeometry x="60" y="320" width="340" height="180" as="geometry"/>
</mxCell>

<mxCell id="e12" value="提供" style="endArrow=blockThin;endFill=1;strokeWidth=2;strokeColor=#7F8C8D;fontSize=11;fontColor=#7F8C8D;fontStyle=1;labelBackgroundColor=#FFF;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>

<!-- FPredictionKeyDelegates -->
<mxCell id="s3" value="&lt;b style=&quot;font-size:16px;&quot;&gt;FPredictionKeyDelegates&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#555;&quot;&gt;委托注册表 (静态单例)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#999;&quot;&gt;─────────────────────────────&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;▸ DelegateMap: TMap&amp;lt;KeyType, FDelegates&amp;gt;&lt;br&gt;▸ RejectedDelegates[] / CaughtUpDelegates[]&lt;br&gt;▸ Reject(Key) / CatchUpTo(Key)&lt;br&gt;▸ AddDependency(ThisKey, DependsOn)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=12;arcSize=14;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
  <mxGeometry x="500" y="320" width="360" height="180" as="geometry"/>
</mxCell>

<mxCell id="e23" value="委托转发" style="endArrow=blockThin;endFill=1;strokeWidth=2;strokeColor=#b85450;fontSize=11;fontColor=#b85450;fontStyle=1;labelBackgroundColor=#FFF;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>

