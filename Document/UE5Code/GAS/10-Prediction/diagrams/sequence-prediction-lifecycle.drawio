        </mxCell>
        <mxCell id="ins2" value="② Redo（确认）：Succeed RPC 立即到达，但属性复制几帧后才到" style="text;html=1;strokeColor=none;fillColor=none;fontSize=9;fontColor=#4A148C;align=left;" parent="1" vertex="1">
