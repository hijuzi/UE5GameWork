        </mxCell>
        <mxCell id="ins3" value="③ 真正撤销本地预测，要等 ReplicatedPredictionKey 追上 (OnRep → CatchUpTo)" style="text;html=1;strokeColor=none;fillColor=none;fontSize=9;fontColor=#4A148C;align=left;" parent="1" vertex="1">
          <mxGeometry x="520" y="848" width="440" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="ins4" value="④ FPredictionKey 只回传给发起它的客户端 (NetSerialize)" style="text;html=1;strokeColor=none;fillColor=none;fontSize=9;fontColor=#4A148C;align=left;" parent="1" vertex="1">
          <mxGeometry x="520" y="872" width="440" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="ins5" value="⑤ 预测窗口仅限 ActivateAbility 调用栈，不跨帧 (Timer/latent 会失效)" style="text;html=1;strokeColor=none;fillColor=none;fontSize=9;fontColor=#4A148C;align=left;" parent="1" vertex="1">
