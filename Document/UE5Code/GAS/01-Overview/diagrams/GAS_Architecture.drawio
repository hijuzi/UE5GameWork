<mxCell id="t" value="GAS 核心数据流 — 从输入到表现的五阶段流水线" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#1a1a2e;align=center;" vertex="1" parent="1">
  <mxGeometry x="300" y="10" width="1200" height="36" as="geometry"/>
</mxCell>

<!-- Stage 1: Input -->
<mxCell id="s1" value="&lt;b style=&quot;font-size:16px;&quot;&gt;① 输入触发&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#555;&quot;&gt;Input mapping → Ability&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#999;&quot;&gt;─────────────────&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;▸ 按键 → AbilityTag 映射&lt;br&gt;▸ Pressed / Released 事件&lt;br&gt;▸ EnhancedInput 集成&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999;strokeWidth=2;fontSize=12;arcSize=14;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
  <mxGeometry x="40" y="70" width="245" height="135" as="geometry"/>
</mxCell>

<mxCell id="e12" value="TryActivateAbility()" style="endArrow=blockThin;endFill=1;strokeWidth=3;strokeColor=#6c8ebf;fontSize=10;fontColor=#6c8ebf;fontStyle=1;labelBackgroundColor=#FFF;edgeStyle=none;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>

<!-- Stage 2: GA -->
<mxCell id="s2" value="&lt;b style=&quot;font-size:16px;&quot;&gt;② GameplayAbility&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#555;&quot;&gt;技能逻辑执行单元&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#999;&quot;&gt;─────────────────&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;▸ InstancingPolicy 实例化策略&lt;br&gt;▸ NetExecutionPolicy 控制预测&lt;br&gt;▸ AbilityTags 匹配与阻塞&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;arcSize=14;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
  <mxGeometry x="360" y="70" width="245" height="135" as="geometry"/>
</mxCell>

<mxCell id="e23" value="MakeOutgoingSpec()" style="endArrow=blockThin;endFill=1;strokeWidth=3;strokeColor=#b85450;fontSize=10;fontColor=#b85450;fontStyle=1;labelBackgroundColor=#FFF;edgeStyle=none;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>

<!-- Stage 3: GE -->
<mxCell id="s3" value="&lt;b style=&quot;font-size:16px;&quot;&gt;③ GameplayEffect&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#555;&quot;&gt;运行时效果实例 (GE Spec)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#999;&quot;&gt;─────────────────&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;▸ Modifier 四种 Magnitude 来源&lt;br&gt;▸ Duration / Infinite / Instant&lt;br&gt;▸ SetByCaller 运行时动态数值&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=12;arcSize=14;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
  <mxGeometry x="680" y="70" width="245" height="135" as="geometry"/>
</mxCell>

<mxCell id="e34" value="ApplyGameplayEffectToSelf()" style="endArrow=blockThin;endFill=1;strokeWidth=3;strokeColor=#d6b656;fontSize=9;fontColor=#b8860b;fontStyle=1;labelBackgroundColor=#FFF;edgeStyle=none;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>

<!-- Stage 4: ASC + AttributeSet -->
<mxCell id="s4" value="&lt;b style=&quot;font-size:16px;&quot;&gt;④ ASC + AttributeSet&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#555;&quot;&gt;核心调度器 + 属性数据&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#999;&quot;&gt;─────────────────&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;▸ Aggregator 多 GE 效果叠算&lt;br&gt;▸ PreAttributeChange 回调链&lt;br&gt;▸ PostGameplayEffectExecute&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;arcSize=14;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
  <mxGeometry x="1000" y="70" width="245" height="135" as="geometry"/>
</mxCell>

<mxCell id="e45" value="Tag Change → Trigger Cue" style="endArrow=blockThin;endFill=1;strokeWidth=3;strokeColor=#0e8088;fontSize=9;fontColor=#0e8088;fontStyle=1;labelBackgroundColor=#FFF;edgeStyle=none;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell>

<!-- Stage 5: GameplayCue -->
<mxCell id="s5" value="&lt;b style=&quot;font-size:16px;&quot;&gt;⑤ GameplayCue&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#555;&quot;&gt;视觉 / 音效表现层&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#999;&quot;&gt;─────────────────&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;▸ Tag 驱动，逻辑与表现解耦&lt;br&gt;▸ Burst 一次性 / Looping 持续&lt;br&gt;▸ 支持 Niagara / Sound / Camera&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;strokeWidth=2;fontSize=12;arcSize=14;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
  <mxGeometry x="1320" y="70" width="245" height="135" as="geometry"/>
</mxCell>

