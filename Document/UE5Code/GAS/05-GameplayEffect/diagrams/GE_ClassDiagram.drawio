<mxCell id="t" value="GameplayEffect 核心类结构 —— CDO→Spec→ActiveGE 三级流水线" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#1a1a2e;align=center;" vertex="1" parent="1">
  <mxGeometry x="250" y="10" width="1200" height="36" as="geometry"/>
</mxCell>

<!-- Stage 1: UGameplayEffect (CDO) -->
<mxCell id="s1" value="&lt;b style=&quot;font-size:16px;&quot;&gt;① UGameplayEffect (CDO)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#555;&quot;&gt;数据资产模板 · 不可修改&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#999;&quot;&gt;─────────────────────────────&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;▸ DurationPolicy / DurationMagnitude&lt;br&gt;▸ Period (执行间隔)&lt;br&gt;▸ Modifiers: TArray&amp;lt;FGameplayModifierInfo&amp;gt;&lt;br&gt;▸ StackingType / StackLimitCount&lt;br&gt;▸ GEComponents: TArray&amp;lt;UGameplayEffectComponent*&amp;gt;&lt;br&gt;▸ GameplayCues: TArray&amp;lt;FGameplayEffectCue&amp;gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;arcSize=14;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
  <mxGeometry x="40" y="70" width="300" height="215" as="geometry"/>
</mxCell>

<mxCell id="e12" value="MakeOutgoingSpec()&#xa;→ 冻结模板参数" style="endArrow=blockThin;endFill=1;strokeWidth=3;strokeColor=#b85450;fontSize=11;fontColor=#b85450;fontStyle=1;labelBackgroundColor=#FFF;edgeStyle=none;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>

<!-- Stage 2: FGameplayEffectSpec -->
<mxCell id="s2" value="&lt;b style=&quot;font-size:16px;&quot;&gt;② FGameplayEffectSpec&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#555;&quot;&gt;运行时冻结快照 · Struct&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#999;&quot;&gt;─────────────────────────────&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;▸ Def: const UGameplayEffect*&lt;br&gt;▸ Modifiers: TArray&amp;lt;FModifierSpec&amp;gt;&amp;nbsp;&amp;nbsp;&lt;i&gt;(数值已冻结)&lt;/i&gt;&lt;br&gt;▸ Duration / Period / Level&lt;br&gt;▸ StackCount&lt;br&gt;▸ SetByCaller 字典：Tag + FName 双通道&lt;br&gt;▸ CapturedRelevantAttributes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=12;arcSize=14;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
  <mxGeometry x="440" y="70" width="320" height="215" as="geometry"/>
</mxCell>

<mxCell id="e23" value="ApplyGameplayEffectSpecToSelf()&#xa;→ 推入 ASC 活跃列表" style="endArrow=blockThin;endFill=1;strokeWidth=3;strokeColor=#82b366;fontSize=11;fontColor=#82b366;fontStyle=1;labelBackgroundColor=#FFF;edgeStyle=none;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>

<!-- Stage 3: FActiveGameplayEffect -->
<mxCell id="s3" value="&lt;b style=&quot;font-size:16px;&quot;&gt;③ FActiveGameplayEffect&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#555;&quot;&gt;目标端状态追踪 · Struct&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#999;&quot;&gt;─────────────────────────────&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;▸ Spec: FGameplayEffectSpec&lt;br&gt;▸ Handle: FActiveGameplayEffectHandle&lt;br&gt;▸ StartWorldTime / CachedStartServerWorldTime&lt;br&gt;▸ Duration / StackCount&lt;br&gt;▸ bIsInhibited (抑制控制)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;arcSize=14;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
  <mxGeometry x="860" y="70" width="320" height="215" as="geometry"/>
</mxCell>

<!-- Context Container -->
<mxCell id="ctx" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b0e3e6;strokeWidth=2;dashed=1;arcSize=14;" vertex="1" parent="1">
  <mxGeometry x="40" y="310" width="1140" height="170" as="geometry"/>
</mxCell>
<mxCell id="ctxlab" value="&lt;b&gt;FGameplayEffectContext&lt;/b&gt; — 附加数据结构（继承可扩展）" style="text;html=1;fontSize=13;fontColor=#0e8088;fontStyle=1;align=center;" vertex="1" parent="1">
  <mxGeometry x="250" y="312" width="720" height="22" as="geometry"/>
</mxCell>

<mxCell id="ctx1" value="&lt;b&gt;👤 来源身份&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Instigator (UAbilitySystemComponent 持有者)&lt;br&gt;EffectCauser (物理发起者: 武器/投掷物)&lt;br&gt;AbilityCDO / AbilityInstanceNotReplicated&lt;br&gt;AbilityLevel / SourceObject&lt;br&gt;InstigatorAbilitySystemComponent&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5f8;strokeColor=#82c7cc;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
  <mxGeometry x="60" y="342" width="290" height="118" as="geometry"/>
</mxCell>
<mxCell id="ctx2" value="&lt;b&gt;📍 物理/Trace 数据&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;HitResult (TSharedPtr&amp;lt;FHitResult&amp;gt;, 可空)&lt;br&gt;WorldOrigin + bHasWorldOrigin&lt;br&gt;Actors[] (关联Actor列表)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5f8;strokeColor=#82c7cc;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
  <mxGeometry x="370" y="342" width="290" height="118" as="geometry"/>
</mxCell>
<mxCell id="ctx3" value="&lt;b&gt;🔁 网络控制&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;bReplicateSourceObject : 1&lt;br&gt;bReplicateInstigator : 1&lt;br&gt;bReplicateEffectCauser : 1&lt;br&gt;(位域, 自身不复制)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5f8;strokeColor=#82c7cc;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
  <mxGeometry x="680" y="342" width="290" height="118" as="geometry"/>
</mxCell>

<mxCell id="ctxnote" value="&lt;b&gt;⚠️ 扩展方式&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;FGameplayEffectContext 通过 &lt;/font&gt;&lt;b&gt;FGameplayEffectContextHandle&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;包装后传入 MakeOutgoingSpec()。需要额外字段？&lt;br&gt;👉 继承 FGameplayEffectContext 并重写&lt;br&gt;&lt;b&gt;GetScriptStruct / NetSerialize / Duplicate&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F57F17;strokeWidth=1;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
  <mxGeometry x="990" y="342" width="275" height="118" as="geometry"/>
</mxCell>

