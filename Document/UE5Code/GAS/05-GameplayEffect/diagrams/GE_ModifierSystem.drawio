</mxCell>
<mxCell id="o5" value="&lt;b&gt;⑤ AddFinal (5)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Σ 求和后加入&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#555;&quot;&gt;最终+10 (穿透/固伤)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;arcSize=10;fontSize=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
