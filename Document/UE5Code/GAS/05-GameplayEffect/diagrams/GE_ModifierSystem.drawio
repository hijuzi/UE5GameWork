</mxCell>
<mxCell id="ea3" value="" style="endArrow=blockThin;endFill=1;strokeWidth=2;strokeColor=#d79b00;" edge="1" parent="1">
  <mxGeometry relative="1" as="geometry"><mxPoint x="930" y="450" as="sourcePoint"/><mxPoint x="980" y="450" as="targetPoint"/></mxGeometry>
</mxCell>

<mxCell id="agg4" value="&lt;b&gt;输出&lt;/b&gt;&lt;br&gt;FinalValue&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#555;&quot;&gt;作为该 Attribute 的&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#555;&quot;&gt;CurrentValue 返回&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;arcSize=10;fontSize=11;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
