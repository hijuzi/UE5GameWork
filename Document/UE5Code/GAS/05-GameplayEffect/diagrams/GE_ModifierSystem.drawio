<mxCell id="r4c2" value="MultiplyMods 真正连乘 → ×" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f8f8;strokeColor=#cccccc;fontSize=11;" vertex="1" parent="1">
