<mxCell id="agg1" value="&lt;b&gt;传入参数&lt;/b&gt;&lt;br&gt;InlineBaseValue&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#555;&quot;&gt;调用方传入的基准值&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#888;&quot;&gt;（首 Channel 通常来自&lt;br&gt;FAttributeData::BaseValue，&lt;br&gt;即面板属性值）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d79b00;strokeWidth=1;arcSize=10;fontSize=11;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
  <mxGeometry x="55" y="405" width="180" height="100" as="geometry"/>
</mxCell>
<mxCell id="ea1" value="" style="endArrow=blockThin;endFill=1;strokeWidth=2;strokeColor=#d79b00;" edge="1" parent="1">
  <mxGeometry relative="1" as="geometry"><mxPoint x="240" y="450" as="sourcePoint"/><mxPoint x="280" y="450" as="targetPoint"/></mxGeometry>
</mxCell>

<mxCell id="agg2" value="&lt;b&gt;公式前半（括号内）&lt;/b&gt;&lt;br&gt;(InlineBaseValue + ΣAddBase)&lt;br&gt;× ΣMultiplyAdditive&lt;br&gt;÷ ΣDivideAdditive&#xa;&lt;font style=&quot;font-size:10px;color:#555;&quot;&gt;&lt;font color=&quot;#82b366&quot;&gt;Σ&lt;/font&gt; = SumMods 聚合（每类型独立叠加）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d79b00;strokeWidth=1;arcSize=10;fontSize=11;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
  <mxGeometry x="285" y="405" width="320" height="90" as="geometry"/>
</mxCell>
<mxCell id="ea2" value="" style="endArrow=blockThin;endFill=1;strokeWidth=2;strokeColor=#d79b00;" edge="1" parent="1">
  <mxGeometry relative="1" as="geometry"><mxPoint x="610" y="450" as="sourcePoint"/><mxPoint x="660" y="450" as="targetPoint"/></mxGeometry>
</mxCell>

<mxCell id="agg3" value="&lt;b&gt;公式后半（括号外）&lt;/b&gt;&lt;br&gt;× ΠMultiplyCompound&lt;br&gt;+ ΣAddFinal&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#555;&quot;&gt;&lt;font color=&quot;#b85450;&quot;&gt;Π&lt;/font&gt; = MultiplyMods 真正连乘（不走 SumMods！）&lt;br&gt;&lt;font color=&quot;#82b366&quot;&gt;Σ&lt;/font&gt; = SumMods 聚合&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d79b00;strokeWidth=1;arcSize=10;fontSize=11;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
