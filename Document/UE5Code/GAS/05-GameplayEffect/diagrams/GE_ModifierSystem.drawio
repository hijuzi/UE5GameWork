</mxCell>
<mxCell id="agglab" value="&lt;b&gt;FAggregator::EvaluateWithBase&lt;/b&gt; — 按 ModOp 类型分组聚合（非顺序迭代）" style="text;html=1;fontSize=13;fontColor=#d79b00;fontStyle=1;align=center;" vertex="1" parent="1">
  <mxGeometry x="350" y="375" width="900" height="20" as="geometry"/>
</mxCell>

<mxCell id="agg1" value="&lt;b&gt;Step 1&lt;/b&gt;&lt;br&gt;BaseValue&lt;br&gt;Snapshot&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#555;&quot;&gt;读取 Backing Attr. 值&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d79b00;strokeWidth=1;arcSize=10;fontSize=11;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
  <mxGeometry x="55" y="405" width="180" height="90" as="geometry"/>
</mxCell>
<mxCell id="ea1" value="" style="endArrow=blockThin;endFill=1;strokeWidth=2;strokeColor=#d79b00;" edge="1" parent="1">
  <mxGeometry relative="1" as="geometry"><mxPoint x="240" y="450" as="sourcePoint"/><mxPoint x="280" y="450" as="targetPoint"/></mxGeometry>
</mxCell>

<mxCell id="agg2" value="&lt;b&gt;Step 2: Base 阶段&lt;/b&gt;&lt;br&gt;(BaseValue + ΣAddBase)&lt;br&gt;× ΠMultiplyAdditive&lt;br&gt;÷ (1 + ΣDivideAdditive)&#xa;&lt;font style=&quot;font-size:10px;color:#555;&quot;&gt;同类 Aggregator Channel 先各自聚合&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d79b00;strokeWidth=1;arcSize=10;fontSize=11;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
  <mxGeometry x="285" y="405" width="320" height="90" as="geometry"/>
</mxCell>
<mxCell id="ea2" value="" style="endArrow=blockThin;endFill=1;strokeWidth=2;strokeColor=#d79b00;" edge="1" parent="1">
  <mxGeometry relative="1" as="geometry"><mxPoint x="610" y="450" as="sourcePoint"/><mxPoint x="660" y="450" as="targetPoint"/></mxGeometry>
</mxCell>

<mxCell id="agg3" value="&lt;b&gt;Step 3: Final 阶段&lt;/b&gt;&lt;br&gt;× ΠMultiplyCompound&lt;br&gt;+ ΣAddFinal&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#555;&quot;&gt;在 Base 阶段结果上二次运算&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d79b00;strokeWidth=1;arcSize=10;fontSize=11;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
  <mxGeometry x="665" y="405" width="260" height="90" as="geometry"/>
</mxCell>
<mxCell id="ea3" value="" style="endArrow=blockThin;endFill=1;strokeWidth=2;strokeColor=#d79b00;" edge="1" parent="1">
  <mxGeometry relative="1" as="geometry"><mxPoint x="930" y="450" as="sourcePoint"/><mxPoint x="980" y="450" as="targetPoint"/></mxGeometry>
</mxCell>

<mxCell id="agg4" value="&lt;b&gt;Step 4&lt;/b&gt;&lt;br&gt;FinalValue&lt;br&gt;写入 FAggregator&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#555;&quot;&gt;SetAttribute() 最终生效&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;arcSize=10;fontSize=11;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
  <mxGeometry x="985" y="405" width="200" height="90" as="geometry"/>
</mxCell>

<mxCell id="formula" value="&lt;b style=&quot;font-size:13px;color:#d79b00;&quot;&gt;核心公式：&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;&quot;&gt;FinalValue = ((BaseValue + ΣAddBase)&lt;br&gt;× ΠMultiplyAdditive ÷ (1 + ΣDivideAdditive)&lt;br&gt;× ΠMultiplyCompound) + ΣAddFinal&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=1;arcSize=10;fontSize=12;fontStyle=0;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
  <mxGeometry x="1210" y="405" width="330" height="90" as="geometry"/>
</mxCell>

