</mxCell>

<mxCell id="formula" value="&lt;b style=&quot;font-size:13px;color:#d79b00;&quot;&gt;唯一公式（源码 L98）：&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;&quot;&gt;FinalValue =&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;&quot;&gt;((InlineBaseValue + ΣAddBase)&lt;br&gt;× ΣMultiplyAdditive&lt;br&gt;÷ ΣDivideAdditive&lt;br&gt;× ΠMultiplyCompound)&lt;br&gt;+ ΣAddFinal&lt;/font&gt;&#xa;&lt;font style=&quot;font-size:10px;color:#888;&quot;&gt;&lt;font color=&quot;#82b366&quot;&gt;Σ&lt;/font&gt; = SumMods 聚合&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;Π&lt;/font&gt; = MultiplyMods 连乘&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=1;arcSize=10;fontSize=12;fontStyle=0;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
