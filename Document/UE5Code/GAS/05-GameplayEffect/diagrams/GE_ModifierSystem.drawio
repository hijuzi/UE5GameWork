<!-- ===== Practice Notes ===== -->
<mxCell id="note" value="&lt;b&gt;实践关键点&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;1. &lt;b&gt;同类型先聚合&lt;/b&gt;：多个 AddBase 先 Σ 求和再参与运算，非数组顺序逐个执行&lt;br&gt;2. &lt;b&gt;Period 触发更新&lt;/b&gt;：GE 有 Period &gt; 0 时，每个 Period 触发 Aggregator 重新计算 (EvaluateWithBase)&lt;br&gt;3. &lt;b&gt;SetByCaller&lt;/b&gt; 需要 GA 创建 Spec 时调用 SetSetByCallerMagnitude() 传值，值在 Spec 创建时冻结&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F57F17;strokeWidth=1;arcSize=10;fontSize=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
  <mxGeometry x="40" y="790" width="1520" height="85" as="geometry"/>
</mxCell>

