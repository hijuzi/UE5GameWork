<!-- Row 1: Base Stage ops (AddBase=0, MultiplyAdditive=1, DivideAdditive=2) -->
<mxCell id="o1" value="&lt;b&gt;① AddBase (0)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;BaseValue += Magnitude&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#555;&quot;&gt;伤害30, Lv3→90 累加到Base&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;arcSize=10;fontSize=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
  <mxGeometry x="990" y="135" width="175" height="75" as="geometry"/>
</mxCell>
<mxCell id="o2" value="&lt;b&gt;② MultiplyAdditive (1)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Σ 连乘后 × Base&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#555;&quot;&gt;50%+50%=1.5+1.5=2.0倍率&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;arcSize=10;fontSize=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
  <mxGeometry x="1180" y="135" width="175" height="75" as="geometry"/>
</mxCell>
<mxCell id="o3" value="&lt;b&gt;③ DivideAdditive (2)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;÷ (1 + Σ Divide)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#555;&quot;&gt;2个÷2→÷(1+2)=÷3折减&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;arcSize=10;fontSize=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
  <mxGeometry x="1370" y="135" width="155" height="75" as="geometry"/>
</mxCell>

<!-- Row 2: Final Stage ops (MultiplyCompound=4, AddFinal=5) -->
<!-- Note: value 3 was Override, now deprecated -->
<mxCell id="o4" value="&lt;b&gt;④ MultiplyCompound (4)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Π 连续叠乘&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#555;&quot;&gt;1.5×1.5=2.25 (复合叠加)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;arcSize=10;fontSize=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
