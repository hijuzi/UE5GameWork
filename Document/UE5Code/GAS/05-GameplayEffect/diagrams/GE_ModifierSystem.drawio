<!-- ===== Practice Notes ===== -->
<mxCell id="note" value="&lt;b&gt;实践关键点&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;1. &lt;b&gt;同类型先聚合&lt;/b&gt;：所有同 ModOp 的 Magnitude 先 SumMods 叠加（或 MultiplyMods 连乘），再代入公式（非数组顺序逐个执行）&lt;br&gt;2. &lt;b&gt;InlineBaseValue ≠ FAttributeData::BaseValue&lt;/b&gt;：InlineBaseValue 是 EvaluateWithBase 的传入参数，首 Channel 通常来自面板属性值；Multi-Channel 时上一 Channel 输出即为下一 Channel 的 InlineBaseValue&lt;br&gt;3. &lt;b&gt;Period 触发重新计算&lt;/b&gt;：GE 有 Period &gt; 0 时，每个 Period 触发 Aggregator 重新 EvaluateWithBase，使持续效果动态反映当前属性值&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F57F17;strokeWidth=1;arcSize=10;fontSize=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
  <mxGeometry x="40" y="790" width="1520" height="85" as="geometry"/>
</mxCell>

</root></mxGraphModel>