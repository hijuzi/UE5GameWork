          </mxGeometry>
        </mxCell>

        <mxCell id="ps" value="PlayerState" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7986CB;strokeColor=#5C6BC0;fontSize=13;fontColor=#FFFFFF;fontStyle=1;arcSize=10;" vertex="1" parent="1">
