        <!-- ===== Avatar Panel (Right) ===== -->
        <mxCell id="avatarbg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#81C784;arcSize=10;opacity=60;" vertex="1" parent="1">
          <mxGeometry x="530" y="62" width="500" height="250" as="geometry" />
