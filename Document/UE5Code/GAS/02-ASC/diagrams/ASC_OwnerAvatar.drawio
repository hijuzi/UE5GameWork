        <mxCell id="asc" value="AbilitySystemComponent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3949AB;strokeColor=#1A237E;fontSize=13;fontColor=#FFFFFF;fontStyle=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="264" width="260" height="38" as="geometry" />
